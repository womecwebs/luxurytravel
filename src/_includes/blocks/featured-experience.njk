<div class="card-deals-container bg-white rounded-lg">
  <div class="card-daels">
    <a href="{{ exp.url }}">
      <img
        class="w-full h-full object-cover m-0"
        loading="lazy"
        src="{{ exp.data.image }}"
        alt="{{ exp.data.title }}"
        width="600"
        height="400"
      />
    </a>
  </div>

  <div class="pl-1-5 pr-1-5 pb-4 text-left">
    <a href="{{ exp.url }}">
      <h3>{{ exp.data.title }}</h3>
      <p>{{ exp.data.excerpt }}</p>
    </a>
    <a href="{{ exp.url }}" class="link">View experience</a>
  </div>
</div>

